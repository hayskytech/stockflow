NODE_ENV=development
APP_PORT=4000
APP_NAME=StockFlow
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stockflow
DB_USER=root
DB_PASSWORD=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated exact origins. Outside production, loopback and private LAN origins
# (127.x, 10.x, 192.168.x, 172.16-31.x) are also accepted without being listed here.
CORS_ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# MSG91 OTP widget, driven entirely server-side (no browser SDK, no captcha).
# MSG91_AUTH_KEY is the account authkey under Settings > Authkey — NOT the widget's `tokenAuth`,
# which looks almost identical and only works from the browser SDK.
# MSG91_SEND_PATH must match how the widget is configured in the MSG91 dashboard:
#   sendOtp        -> Widget Integration = web AND Captcha Validation = OFF
#   sendOtpMobile  -> Widget Integration = Mobile
# Nothing in the widget id reveals which it is, and a mismatch fails silently at HTTP 200 —
# find out with:  npm run msg91:check -- 919876543210
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_WIDGET_ID=replace-with-msg91-widget-id
MSG91_SEND_PATH=sendOtp

# Defensive local ceiling on a code's usable life and how many codes one phone may request.
# MSG91 owns the real expiry and per-code attempt cap.
OTP_TTL_MINUTES=10
OTP_MAX_SENDS_PER_PHONE=5
OTP_SEND_WINDOW_MINUTES=15

MEDIA_UPLOAD_DIR=uploads/media
MEDIA_PUBLIC_PATH=/api/media-files
MEDIA_MAX_UPLOAD_MB=15
MEDIA_MAX_BYTES=512000
MEDIA_ORPHAN_TTL_HOURS=24

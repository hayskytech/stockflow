# Root-relative so the app works from localhost, 127.0.0.1 or a LAN IP with no per-machine change.
# The Vite dev server proxies /api to VITE_DEV_BACKEND_ORIGIN (dev only — ignored by the build).
# Set an absolute URL instead only when the API lives on a different origin than the frontend.
VITE_API_URL=/api
VITE_DEV_BACKEND_ORIGIN=http://localhost:4000

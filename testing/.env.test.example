# Playwright e2e config — copy to `.env.test` and adjust.
# `.env.test` is gitignored; this example is committed.

# --- Frontend under test ---------------------------------------------------------
# Where the Vite dev server is reachable. playwright.config.js also starts it
# (webServer.command = "npm run dev" in ../frontend) and reuses an existing one.
FRONTEND_URL=http://localhost:5173

# --- Seed credentials (from database/init/02_seed.sql) --------------------------
# All seed users share the password below.
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=NewPassword@123
TEST_STAFF_EMAIL=staff@example.com
TEST_STAFF_PASSWORD=NewPassword@123

# admin@example.com — platform super admin + admin of BOTH seed businesses
#                     (slugs `default` / `demo-cloth-co`,
#                      ids b0000000-0000-4000-8000-000000000001 / ...0002).
#                     Logs in to the business picker (/#/businesses).
# staff@example.com — staff of "Default Business" only. Logs in straight to
#                     /#/b/b0000000-0000-4000-8000-000000000001/dashboard.

# --- Optional: used by `npm run reset-admin-password` ---------------------------
# That script also reads DB_* from ../backend/.env.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=stockflow
# DB_USER=stockflow
# DB_PASSWORD=

# ------------------------------------------------------------------------------
# BEFORE RUNNING THE SUITE
# ------------------------------------------------------------------------------
# 1. MySQL seeded from a fresh:
#      database/init/01_schema.sql   then   database/init/02_seed.sql
#    (plus the numbered migrations 03_*..NN_* if the DB predates them).
# 2. Backend API running against that DB, with STOREFRONT_ENABLED=false
#    (the storefront / customer-facing routes are on hold — multitenant_plan.md Phase 1).
# 3. Frontend dev server running (or let Playwright start it — see webServer above).
#
# playwright.config.js only starts the FRONTEND. Bringing up the backend + a seeded
# DB is the operator's responsibility for now. Future improvement: add a second
# `webServer` entry that runs the backend (and a DB reset/seed step) so `npx playwright
# test` is fully self-contained.
